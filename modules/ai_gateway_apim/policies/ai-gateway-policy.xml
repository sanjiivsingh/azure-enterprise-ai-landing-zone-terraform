<!--
  Azure API Management - Enterprise AI Gateway Policy
  Implements:
  1. Token Rate Limiting (TPM/RPM per subscriber key)
  2. Managed Identity Authentication against private Azure OpenAI endpoint
  3. Automatic Retry and Circuit Failover on HTTP 429 (Rate Limit) / 5xx responses
  4. Response Header Emission for Client Token Telemetry
  Note: Semantic Caching requires an external Azure Cache for Redis connection configured in APIM.
-->
<policies>
    <inbound>
        <base />
        <!-- AI Gateway: Token-based throttling per consumer subscription key -->
        <azure-openai-token-limit counter-key="@(context.Subscription.Id)"
                                  tokens-per-minute="10000"
                                  estimate-prompt-tokens="false"
                                  remaining-tokens-variable-name="remainingTokens" />

        <!-- Authenticate against Azure OpenAI via APIM System-Assigned Managed Identity -->
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    </inbound>
    <backend>
        <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode &gt;= 500)" count="3" interval="2" max-interval="10" delta="1" first-fast-retry="true">
            <forward-request timeout="60" />
        </retry>
    </backend>
    <outbound>
        <base />
        <!-- Expose token telemetry headers to consumer -->
        <set-header name="x-ai-remaining-tokens" exists-action="override">
            <value>@(context.Variables.GetValueOrDefault<string>("remainingTokens"))</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
